# Database Configuration
DATABASE_URL=postgresql://niyati_user:niyati_password@localhost:5432/niyati_db

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=niyati_password

# LLM Configuration
# Options: "groq" or "openai"
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here

# Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production

# Performance Configuration
CIRCUIT_BREAKER_THRESHOLD=3
BATCH_SIZE=500

# Optional: Email Configuration for High-Risk Alerts
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# AUDIT_TEAM_EMAIL=audit-team@example.com
