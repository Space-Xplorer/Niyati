# ═══════════════════════════════════════════════════════
# Niyati Backend — Environment Variables Template
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///niyati.db

# Neo4j AuraDB
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# LLM Provider
LLM_PROVIDER=groq
LLM_API_KEY=your-llm-api-key

# Authentication
JWT_SECRET=generate-a-strong-random-secret-here

# CORS — comma-separated frontend origins for production
# CORS_ORIGINS=https://your-frontend.vercel.app,https://your-admin.vercel.app

# Performance
CIRCUIT_BREAKER_THRESHOLD=3
BATCH_SIZE=500

# Cloud Run
# PORT=8080  (set automatically by Cloud Run)
